rules_version = '2';

// قواعد حماية قاعدة بيانات نظام الحضور - جامعة المعقل الأهلية
// انسخ هذا الملف إلى: Firebase Console > Firestore Database > Rules ثم اضغط Publish
//
// الهوية = البريد الجامعي الموثّق من Google.
// الكادر: staff/<البريد>  •  الطلاب: students/<الرقم المعرفي>
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }

    // المدير العام (عدّل القائمة لتطابق superAdminEmails في config.dart)
    function isSuperAdmin() {
      return signedIn() && email() in ['drdsh.sw2022@gmail.com'];
    }

    // البريد الجامعي الرسمي فقط (أو المدير العام)
    function isMember() {
      return signedIn() && request.auth.token.email_verified == true &&
        (email().matches('.*@almaaqal[.]edu[.]iq') || isSuperAdmin());
    }

    function isStaff() {
      return isMember() && exists(/databases/$(database)/documents/staff/$(email()));
    }

    function isAdmin() {
      return isSuperAdmin() ||
        (isStaff() && get(/databases/$(database)/documents/staff/$(email())).data.role == 'admin');
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // البيانات العامة: قراءة لكل منتسب، كتابة للمدير
    match /colleges/{id}    { allow read: if isMember(); allow write: if isAdmin(); }
    match /departments/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /courses/{id}     { allow read: if isMember(); allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if isMember(); allow write: if isAdmin(); }
    match /meta/{id}        { allow read: if isMember(); allow write: if isAdmin(); }

    match /students/{id} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      // الدكتور يستطيع ربط بطاقة NFC بطالب أثناء المحاضرة
      allow update: if isAdmin() || (isStaff() && onlyChanges(['nfcUid']));
    }

    match /staff/{staffEmail} {
      allow read: if isMember();
      allow create: if isAdmin() || (staffEmail == email() && isSuperAdmin());
      allow delete: if isAdmin();
      // الدكتور يعدّل قائمة مواده فقط
      allow update: if isAdmin() || (staffEmail == email() && onlyChanges(['courseIds']));
    }

    match /sessions/{id} {
      allow read: if isMember();
      allow create: if isStaff() && request.resource.data.doctorId == email();
      allow update, delete: if isAdmin() || (isStaff() && resource.data.doctorId == email());
    }

    function isSessionOwner(sessionId) {
      return isStaff() &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.doctorId == email();
    }

    match /attendance/{id} {
      allow read: if isMember();
      // يسجّل الحضور الدكتور صاحب المحاضرة أو المدير فقط (بمسح هوية الطالب أو NFC)
      allow create: if (isAdmin() || isSessionOwner(request.resource.data.sessionId)) &&
        id == request.resource.data.sessionId + '_' + request.resource.data.studentId;
      allow update: if false;
      allow delete: if isAdmin() || isSessionOwner(resource.data.sessionId);
    }
  }
}
